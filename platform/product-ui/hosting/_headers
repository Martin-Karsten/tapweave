# Only content-addressed build assets get immutable caching.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/menu
  Cache-Control: no-cache
/select
  Cache-Control: no-cache
/play
  Cache-Control: no-cache
/results
  Cache-Control: no-cache
/diagnostics
  Cache-Control: no-cache
/demo/*
  Cache-Control: no-cache
/multiplayer
  Cache-Control: no-cache
/room/*
  Cache-Control: no-cache
