{
  "name": "tapweave-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "compile": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "build": "npm run compile && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "test:session": "node scripts/session-evidence.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2"
  }
}
