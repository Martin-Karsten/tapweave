# Public repository allowlist: experiments remain local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/.github/
!/docs/
!/engine/
!/platform/
/platform/*
!/platform/browser-js/

# Historical regression tooling is local-only.
/engine/scripts/test-spike.mjs
/engine/reference/spike-manifest.json

# TypeScript emit for the browser player.
/platform/browser-js/build/

# Product shell (ADR-006): sources are tracked; generated assets are not.
!/platform/product-ui/
/platform/product-ui/dist/
/platform/product-ui/public/

# Toolchains, dependencies, generated output, and credentials.
**/.toolchain/
/engine/.reference/
**/node_modules/
**/artifacts/
**/bin/
**/obj/
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key

# Local Cloudflare emulator state and credentials.
**/.wrangler/
**/.dev.vars
**/.dev.vars.*
